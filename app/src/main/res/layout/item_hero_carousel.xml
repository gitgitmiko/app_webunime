<?xml version="1.0" encoding="utf-8"?>
<!--
  Baris hero dalam VerticalGridView — ikut scroll bersama list di bawahnya.
  Kiri: badge, judul, meta, genre, sinopsis, tombol Tonton. Kanan: poster tajam
  (portrait 2:3, otomatis 16:9 bila gambarnya landscape) di atas backdrop blur.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroCarouselRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/browse_hero_row_height"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/browse_edge_pad"
    android:paddingTop="4dp"
    android:paddingEnd="@dimen/browse_hero_end_pad"
    android:paddingBottom="20dp">

    <LinearLayout
        android:id="@+id/browseHeroText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_weight="1"
        android:focusable="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/browseHeroBadge"
                style="@style/Wu.HeroChip"
                android:background="@drawable/bg_hero_badge" />

            <TextView
                android:id="@+id/browseHeroQuality"
                style="@style/Wu.HeroChip"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_hero_quality"
                android:visibility="gone" />

            <TextView
                android:id="@+id/browseHeroCountry"
                style="@style/Wu.HeroChip"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_hero_chip"
                android:visibility="gone" />

            <TextView
                android:id="@+id/browseHeroNew"
                style="@style/Wu.HeroChip"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_hero_new"
                android:text="@string/hero_badge_new"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/browseHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:focusable="false"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.01"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@color/wu_text"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/browseHeroMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:focusable="false"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/wu_text"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/browseHeroGenres"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/browseHeroSynopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:focusable="false"
            android:lineSpacingExtra="4dp"
            android:maxLines="3"
            android:textColor="@color/wu_text_dim"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:duplicateParentState="true"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/browseHeroCta"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_hero_cta"
                android:duplicateParentState="true"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="28dp"
                android:text="@string/hero_watch"
                android:textColor="@color/hero_cta_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/browseHeroHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:focusable="false"
                android:text="@string/hero_hint"
                android:textColor="@color/wu_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/browseHeroDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/browseHeroPosterWrap"
        android:layout_width="@dimen/hero_poster_w"
        android:layout_height="@dimen/hero_poster_h"
        android:background="@drawable/bg_hero_poster"
        android:clipToOutline="true"
        android:elevation="16dp"
        android:focusable="false"
        android:outlineProvider="background">

        <ImageView
            android:id="@+id/browseHeroPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>
</LinearLayout>
