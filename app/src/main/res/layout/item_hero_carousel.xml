<?xml version="1.0" encoding="utf-8"?>
<!-- Baris hero dalam VerticalGridView — ikut scroll bersama list di bawahnya. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heroCarouselRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/browse_hero_row_height"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="12dp"
    android:paddingEnd="56dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/browseHeroBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_badge"
            android:focusable="false"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:textColor="@color/wu_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/browseHeroQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hero_quality"
            android:focusable="false"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:textColor="@color/wu_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/browseHeroCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hero_chip"
            android:focusable="false"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:textColor="@color/wu_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/browseHeroNew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_hero_new"
            android:focusable="false"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="@string/hero_badge_new"
            android:textColor="@color/wu_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/browseHeroTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:focusable="false"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:maxLines="2"
        android:textColor="@color/wu_text"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/browseHeroMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:focusable="false"
        android:maxLines="1"
        android:textColor="@color/wu_text_dim"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/browseHeroGenres"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/browseHeroSynopsis"
        android:layout_width="@dimen/browse_hero_panel_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:focusable="false"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:textColor="@color/wu_text_dim"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/browseHeroDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
</LinearLayout>
