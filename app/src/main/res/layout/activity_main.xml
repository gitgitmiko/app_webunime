<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wu_bg">

    <ImageView
        android:id="@+id/browseBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/browseBackdropDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="560dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_hero_scrim"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/main_browse_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- Di atas fragment agar teks terlihat; hanya tombol Tonton yang fokus -->
    <LinearLayout
        android:id="@+id/browseHeroPanel"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="140dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/browseHeroBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_badge"
            android:focusable="false"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/wu_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/browseHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="2"
            android:textColor="@color/wu_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/browseHeroMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:focusable="false"
            android:maxLines="1"
            android:textColor="@color/wu_text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/browseHeroSynopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:focusable="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/wu_text_dim"
            android:textSize="14sp" />

        <Button
            android:id="@+id/browseHeroWatch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero_watch"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:minWidth="140dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="@string/hero_watch"
            android:textAllCaps="false"
            android:textColor="@color/wu_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/browseHeroDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/catalogLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wu_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/catalogLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/updating"
            android:textColor="@color/wu_text"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
