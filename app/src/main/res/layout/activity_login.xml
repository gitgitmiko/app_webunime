<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wu_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="72dp"
            android:paddingTop="48dp"
            android:paddingEnd="72dp"
            android:paddingBottom="48dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/brand_name"
                android:maxWidth="320dp"
                android:scaleType="fitCenter"
                android:src="@drawable/brand_wordmark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_subtitle"
                android:textColor="@color/wu_text_dim"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/loginInput"
                android:layout_width="420dp"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:background="@color/wu_surface"
                android:focusable="true"
                android:hint="@string/login_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:nextFocusDown="@id/loginPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/wu_text"
                android:textColorHint="@color/wu_text_muted"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/loginPassword"
                android:layout_width="420dp"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@color/wu_surface"
                android:focusable="true"
                android:hint="@string/login_password"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:nextFocusDown="@id/loginButton"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/wu_text"
                android:textColorHint="@color/wu_text_muted"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginButton"
                android:layout_width="420dp"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:focusable="true"
                android:text="@string/login_action"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/wu_accent"
                app:cornerRadius="4dp" />

            <TextView
                android:id="@+id/loginError"
                android:layout_width="420dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/wu_accent"
                android:textSize="14sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loginProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:indeterminate="true"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/loginSplash"
        layout="@layout/wu_brand_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
