<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wu_bg">

    <!-- Backdrop ambient full-screen (poster di-blur), tetap diam saat konten di-scroll. -->
    <ImageView
        android:id="@+id/detailBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.85"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_detail_scrim"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_detail_bottom_scrim"
        android:importantForAccessibility="no" />

<ScrollView
    android:id="@+id/detailScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/detailPoster"
            android:layout_width="200dp"
            android:layout_height="300dp"
            android:layout_marginStart="48dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_hero_poster"
            android:clipToOutline="true"
            android:contentDescription="@string/app_name"
            android:elevation="16dp"
            android:outlineProvider="background"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="40dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/wu_accent_soft"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/detailPoster"
            app:layout_constraintTop_toTopOf="@id/detailPoster" />

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="40dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.01"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@color/wu_text"
            android:textSize="36sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/detailPoster"
            app:layout_constraintTop_toBottomOf="@id/brand" />

        <TextView
            android:id="@+id/detailMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="40dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/wu_text"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/detailPoster"
            app:layout_constraintTop_toBottomOf="@id/detailTitle" />

        <TextView
            android:id="@+id/detailSynopsis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="40dp"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="4"
            android:textColor="@color/wu_text_dim"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/detailPoster"
            app:layout_constraintTop_toBottomOf="@id/detailMeta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playButton"
            style="@style/Wu.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:focusable="true"
            android:minWidth="168dp"
            android:nextFocusDown="@id/episodeSection"
            android:nextFocusRight="@id/favoriteButton"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/play"
            android:textSize="16sp"
            app:cornerRadius="@dimen/button_corner_radius"
            app:layout_constraintStart_toEndOf="@id/detailPoster"
            app:layout_constraintTop_toBottomOf="@id/detailSynopsis" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favoriteButton"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:focusable="true"
            android:minWidth="168dp"
            android:nextFocusLeft="@id/playButton"
            android:nextFocusRight="@id/partyButton"
            android:nextFocusDown="@id/episodeSection"
            android:text="@string/favorite_add"
            android:textSize="16sp"
            app:cornerRadius="@dimen/button_corner_radius"
            app:layout_constraintBottom_toBottomOf="@id/playButton"
            app:layout_constraintStart_toEndOf="@id/playButton"
            app:layout_constraintTop_toTopOf="@id/playButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/partyButton"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:focusable="true"
            android:minWidth="168dp"
            android:nextFocusLeft="@id/favoriteButton"
            android:nextFocusDown="@id/episodeSection"
            android:text="@string/party_start"
            android:textSize="16sp"
            app:cornerRadius="@dimen/button_corner_radius"
            app:layout_constraintBottom_toBottomOf="@id/playButton"
            app:layout_constraintStart_toEndOf="@id/favoriteButton"
            app:layout_constraintTop_toTopOf="@id/playButton" />

        <ProgressBar
            android:id="@+id/detailLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/detailHeaderBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="detailPoster,playButton,favoriteButton" />

        <TextView
            android:id="@+id/detailCreditsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="28dp"
            style="@style/Wu.SectionTitle"
            android:text="@string/detail_credits"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailHeaderBarrier" />

        <TextView
            android:id="@+id/detailCredits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="40dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/wu_text_dim"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailCreditsLabel" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/detailCreditsBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="detailHeaderBarrier,detailCreditsLabel,detailCredits" />

        <TextView
            android:id="@+id/episodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="32dp"
            style="@style/Wu.SectionTitle"
            android:text="@string/episodes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detailCreditsBarrier" />

        <LinearLayout
            android:id="@+id/episodeSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/episodeLabel">

            <HorizontalScrollView
                android:id="@+id/episodeJumpScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fadeScrollbars="true"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/episodeJumpContainer"
                    android:divider="@drawable/space_h10"
                    android:showDividers="middle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/episodeRangeScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:fadeScrollbars="true"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/episodeRangeContainer"
                    android:divider="@drawable/space_h10"
                    android:showDividers="middle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/episodeScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:fadeScrollbars="true"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/episodeContainer"
                    android:divider="@drawable/space_h10"
                    android:showDividers="middle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/serverLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="24dp"
            style="@style/Wu.SectionTitle"
            android:text="@string/servers"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/episodeSection" />

        <HorizontalScrollView
            android:id="@+id/serverScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:fadeScrollbars="true"
            android:paddingStart="48dp"
            android:paddingEnd="40dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/serverLabel">

            <LinearLayout
                android:id="@+id/serverContainer"
                android:divider="@drawable/space_h10"
                android:showDividers="middle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

    <include layout="@layout/wu_bgm_now_playing" />
</FrameLayout>
