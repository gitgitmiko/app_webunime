<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wu_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="36dp"
        android:paddingEnd="48dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/wu_accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/wu_text_dim"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/settings_section_account"
            android:textColor="@color/wu_row_header"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsAccountName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/wu_text_dim"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/settingsDisplayName"
            android:layout_width="320dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@color/wu_surface"
            android:focusable="true"
            android:hint="@string/settings_display_name"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/wu_text"
            android:textColorHint="@color/wu_text_muted"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsSaveProfile"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="true"
            android:minWidth="280dp"
            android:text="@string/settings_save_profile"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsLogout"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="true"
            android:minWidth="280dp"
            android:text="@string/settings_logout"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/settings_section_update"
            android:textColor="@color/wu_row_header"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsCheckUpdate"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:focusable="true"
            android:minWidth="280dp"
            android:text="@string/settings_check_update"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_check_update_hint"
            android:textColor="@color/wu_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/settings_section_catalog"
            android:textColor="@color/wu_row_header"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsStartScrape"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:focusable="true"
            android:minWidth="280dp"
            android:text="@string/settings_start_scrape"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsRefreshCatalog"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="true"
            android:minWidth="280dp"
            android:text="@string/settings_refresh_catalog"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="4dp" />

        <TextView
            android:id="@+id/settingsCatalogStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_catalog_hint"
            android:textColor="@color/wu_text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
