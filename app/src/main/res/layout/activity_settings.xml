<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wu_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="40dp"
        android:paddingEnd="56dp"
        android:paddingBottom="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="@string/settings"
            android:textColor="@color/wu_accent_soft"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settingsVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/wu_text_dim"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="@string/settings_section_update"
            android:textColor="@color/wu_row_header"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsCheckUpdate"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:minWidth="300dp"
            android:text="@string/settings_check_update"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="@dimen/button_corner_radius" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_check_update_hint"
            android:textColor="@color/wu_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="@string/settings_section_playback"
            android:textColor="@color/wu_row_header"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsToggleFilmServers"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:minWidth="300dp"
            android:text="@string/settings_film_servers_hidden"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="@dimen/button_corner_radius" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_film_servers_hint"
            android:textColor="@color/wu_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="@string/settings_section_bgm"
            android:textColor="@color/wu_row_header"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsToggleBgmMute"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:minWidth="300dp"
            android:text="@string/settings_bgm_mute_off"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="@dimen/button_corner_radius" />

        <TextView
            android:id="@+id/settingsBgmVolumeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_bgm_volume"
            android:textColor="@color/wu_text"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/settingsBgmVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:max="100"
            android:maxWidth="640dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:progressTint="@color/wu_accent"
            android:thumbTint="@color/wu_accent_soft" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_bgm_hint"
            android:textColor="@color/wu_text_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="@string/settings_section_catalog"
            android:textColor="@color/wu_row_header"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsStartScrape"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:minWidth="300dp"
            android:text="@string/settings_start_scrape"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="@dimen/button_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsRefreshCatalog"
            style="@style/Wu.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="true"
            android:minWidth="300dp"
            android:text="@string/settings_refresh_catalog"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="@dimen/button_corner_radius" />

        <TextView
            android:id="@+id/settingsCatalogStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_catalog_hint"
            android:textColor="@color/wu_text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
