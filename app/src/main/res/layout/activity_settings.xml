<?xml version="1.0" encoding="utf-8"?>
<!-- Pengaturan dua kolom: judul + versi di kiri, seksi (panel) bisa di-scroll di kanan. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_glow"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginBottom="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/brand_name"
            android:maxWidth="200dp"
            android:scaleType="fitStart"
            android:src="@drawable/weeboonime" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.02"
            android:text="@string/settings"
            android:textColor="@color/wu_text"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/settingsVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/wu_text_dim"
            android:textSize="15sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="48dp"
        android:paddingEnd="56dp"
        android:paddingBottom="48dp"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Wu.SectionTitle"
                android:text="@string/settings_section_account" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsAccount"
                style="@style/Wu.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:minWidth="300dp"
                android:text="@string/settings_login"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <TextView
                android:id="@+id/settingsAccountStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_account_guest"
                android:textColor="@color/wu_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Wu.SectionTitle"
                android:text="@string/settings_section_party" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsPartyJoin"
                style="@style/Wu.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:minWidth="300dp"
                android:text="@string/settings_party_join"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_party_hint"
                android:textColor="@color/wu_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Wu.SectionTitle"
                android:text="@string/settings_section_update" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsCheckUpdate"
                style="@style/Wu.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:minWidth="300dp"
                android:text="@string/settings_check_update"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_check_update_hint"
                android:textColor="@color/wu_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Wu.SectionTitle"
                android:text="@string/settings_section_playback" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsToggleFilmServers"
                style="@style/Wu.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:minWidth="300dp"
                android:text="@string/settings_film_servers_hidden"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_film_servers_hint"
                android:textColor="@color/wu_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Wu.SectionTitle"
                android:text="@string/settings_section_bgm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsToggleBgmMute"
                style="@style/Wu.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:minWidth="300dp"
                android:text="@string/settings_bgm_mute_off"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <TextView
                android:id="@+id/settingsBgmVolumeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/settings_bgm_volume"
                android:textColor="@color/wu_text"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/settingsBgmVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:focusable="true"
                android:max="100"
                android:maxWidth="640dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:progressTint="@color/wu_accent"
                android:thumbTint="@color/wu_accent_soft" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_bgm_hint"
                android:textColor="@color/wu_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Wu.SectionTitle"
                android:text="@string/settings_section_catalog" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsStartScrape"
                style="@style/Wu.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:minWidth="300dp"
                android:text="@string/settings_start_scrape"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsRefreshCatalog"
                style="@style/Wu.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:focusable="true"
                android:minWidth="300dp"
                android:text="@string/settings_refresh_catalog"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <TextView
                android:id="@+id/settingsCatalogStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_catalog_hint"
                android:textColor="@color/wu_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
