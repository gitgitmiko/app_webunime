<?xml version="1.0" encoding="utf-8"?>
<!-- Title browse: Search + Settings di kiri; badge + nama user + wordmark di kanan. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/title_orb_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.leanback.widget.SearchOrbView
            android:id="@+id/title_orb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:transitionGroup="true"
            android:visibility="invisible" />

        <androidx.leanback.widget.SearchOrbView
            android:id="@+id/settings_orb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:transitionGroup="true"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/title_brand_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title_user_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_user_badge"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textAllCaps="true"
            android:textColor="@color/wu_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxWidth="200dp"
            android:maxLines="1"
            android:textColor="@color/wu_text"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/title_badge"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/brand_name"
            android:maxWidth="220dp"
            android:scaleType="fitEnd"
            android:src="@drawable/weeboonime" />
    </LinearLayout>
</merge>
