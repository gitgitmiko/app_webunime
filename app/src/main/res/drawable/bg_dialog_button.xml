<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/wu_accent" />
            <corners android:radius="6dp" />
            <stroke
                android:width="2dp"
                android:color="@color/wu_focus" />
            <padding
                android:left="18dp"
                android:top="10dp"
                android:right="18dp"
                android:bottom="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/wu_accent_dark" />
            <corners android:radius="6dp" />
            <padding
                android:left="18dp"
                android:top="10dp"
                android:right="18dp"
                android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wu_surface" />
            <corners android:radius="6dp" />
            <padding
                android:left="18dp"
                android:top="10dp"
                android:right="18dp"
                android:bottom="10dp" />
        </shape>
    </item>
</selector>
