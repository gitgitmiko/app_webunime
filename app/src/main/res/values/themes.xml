<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WebunimeTv" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/wu_bg</item>
        <item name="android:colorPrimary">@color/wu_accent</item>
        <item name="defaultBrandColor">@color/wu_bg</item>
        <item name="defaultBrandColorDark">@color/wu_bg</item>
        <item name="defaultSearchColor">@color/wu_accent</item>
        <item name="defaultSearchIconColor">@color/wu_text</item>
        <item name="defaultSearchBrightColor">@color/wu_accent</item>
        <item name="browseTitleTextStyle">@style/Wu.BrowseTitle</item>
        <item name="rowHeaderStyle">@style/Wu.RowHeader</item>
        <!-- Dorong baris (Lanjutkan, dll.) di bawah band hero -->
        <item name="browseRowsMarginTop">@dimen/browse_rows_margin_top</item>
    </style>

    <style name="Wu.BrowseTitle" parent="TextAppearance.Leanback.Title">
        <item name="android:textColor">@color/wu_accent</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Wu.RowHeader" parent="Widget.Leanback.Row.Header">
        <item name="android:textColor">@color/wu_row_header</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.WebunimeTv.Detail" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/wu_bg</item>
        <item name="colorPrimary">@color/wu_accent</item>
        <item name="colorPrimaryVariant">@color/wu_accent_dark</item>
        <item name="colorOnPrimary">@color/wu_text</item>
        <item name="colorSecondary">@color/wu_accent</item>
        <item name="android:statusBarColor">@color/wu_bg</item>
        <item name="materialButtonOutlinedStyle">@style/Wu.Button.Outlined</item>
        <item name="alertDialogTheme">@style/Theme.WebunimeTv.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/Theme.WebunimeTv.AlertDialog</item>
    </style>

    <!-- Dialog TV: tombol fokus jelas (latar merah + border putih). -->
    <style name="Theme.WebunimeTv.AlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/wu_bg_elevated</item>
        <item name="android:textColorPrimary">@color/wu_text</item>
        <item name="android:textColor">@color/wu_text</item>
        <item name="colorAccent">@color/wu_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Wu.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Wu.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Wu.DialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Wu.DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Wu.DialogButton</item>
    </style>

    <style name="Wu.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:background">@drawable/bg_dialog_button</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Wu.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/wu_surface</item>
        <item name="android:textColor">@color/wu_text</item>
        <item name="rippleColor">@color/wu_accent</item>
    </style>

    <style name="Theme.WebunimeTv.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.WebunimeTv.Search" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/wu_bg</item>
        <item name="defaultSearchColor">@color/wu_accent</item>
        <item name="defaultSearchBrightColor">@color/wu_accent</item>
        <item name="defaultBrandColor">@color/wu_bg</item>
    </style>
</resources>
